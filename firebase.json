{
  "firestore": {
    "database": "(default)",
    "location": "asia-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".vercel/**",
      ".firebase/**",
      "api/**",
      "services/**",
      "*.db",
      "*.log",
      "*.json",
      "package*.json",
      "vercel.json"
    ]
  }
}
